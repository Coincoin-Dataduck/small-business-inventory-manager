{
  "name": "stock-hervine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/verifier.sh && wrangler deploy",
    "db:local": "wrangler d1 migrations apply stock-hervine --local",
    "db:remote": "wrangler d1 migrations apply stock-hervine --remote",
    "check": "tsc --noEmit",
    "verifier": "bash scripts/verifier.sh"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  }
}
