{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-hervine",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "public", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-hervine",
      // À remplacer par l'identifiant donné par `wrangler d1 create stock-hervine` au premier déploiement.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
